{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "File 00 Hostinger staging evidence record",
  "type": "object",
  "required": [
    "gate_id",
    "tested_at",
    "timezone",
    "staging_host",
    "file00_version",
    "file00_commit",
    "package_sha256",
    "tester_role",
    "expected",
    "actual",
    "status",
    "evidence_refs",
    "cleanup_state"
  ],
  "properties": {
    "gate_id": {
      "type": "string",
      "minLength": 2
    },
    "tested_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "type": "string",
      "minLength": 1
    },
    "staging_host": {
      "type": "string",
      "minLength": 3
    },
    "file00_version": {
      "const": "1.2.19"
    },
    "file00_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tester_role": {
      "type": "string",
      "minLength": 2
    },
    "expected": {
      "type": "string",
      "minLength": 1
    },
    "actual": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "defect_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cleanup_state": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
